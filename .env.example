# --- Option A: one provider (simplest) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here
# Any OpenRouter model id ending in ":free". Paid models are blocked unless ALLOW_PAID=1.
MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: any other OpenAI-compatible endpoint
# BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-key-here

# --- Option B: fallback chain across free providers (tried in order on rate limit / outage) ---
# The latest test run used Gemini first: LLM_PROVIDERS=gemini,openrouter
# LLM_PROVIDERS=openrouter,gemini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash-lite   # model ids change: pick one your key lists (older ids return 404)

# --- Optional ---
# GROUNDING_CHECK=0        # switch off the extra grounding-check call
# PROMPT_CACHE_MARKERS=1   # add cache breakpoints for Anthropic models on OpenRouter (not yet run live; see README)
