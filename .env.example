# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id ending in ":free" (see https://openrouter.ai/models?q=free).
# Paid models are blocked by core/llm.py unless ALLOW_PAID=1.
MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: point at any other OpenAI-compatible endpoint (e.g. one Kuku provides)
# BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...
# Optional voice input: an audio-capable model id ending in :free
# VOICE_MODEL=
